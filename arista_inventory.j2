! Arista EOS — generated from Nautobot inventory
! Partial configuration for review only
! Includes interface addressing and OSPF
! Other system settings are not included
!
{% set ctx = config_context | default({}) %}
{% set route = ctx.get("routing", routing | default({})) %}
{% set ospf = route.get("ospf", {}) %}
hostname {{ hostname }}
!
{% set vlans = namespace(items={}) %}
{% for interface in interfaces %}
{% if interface.untagged_vlan %}
{% set vlan = interface.untagged_vlan %}
{% set _ = vlans.items.update({vlan.vid: vlan.name}) %}
{% endif %}
{% endfor %}
{% for vid, name in vlans.items | dictsort %}
vlan {{ vid }}
!
{% endfor %}
{% for interface in interfaces | sort(attribute="name") %}
{% if interface.mode == "ACCESS" and interface.untagged_vlan %}
interface {{ interface.name }}
{% if interface.description %}
   description {{ interface.description }}
{% endif %}
   switchport mode access
   switchport access vlan {{ interface.untagged_vlan.vid }}
{% if not interface.enabled %}
   shutdown
{% endif %}
!
{% elif interface.ip_addresses %}
interface {{ interface.name }}
{% if interface.description %}
   description {{ interface.description }}
{% endif %}
{% if interface.name.startswith("Ethernet") and not interface.mode %}
   no switchport
{% endif %}
{% for ip in interface.ip_addresses %}
   ip address {{ ip.address }}
{% endfor %}
{% if interface.name in ospf.get("point_to_point_interfaces", []) %}
   ip ospf network point-to-point
{% endif %}
{% if not interface.enabled %}
   shutdown
{% endif %}
!
{% endif %}
{% endfor %}
{% if route.get("ip_routing", false) %}
ip routing
!
{% endif %}
{% if ospf %}
router ospf {{ ospf.process_id }}
   router-id {{ ospf.router_id }}
{% for interface in interfaces | sort(attribute="name") %}
{% if interface.name in ospf.get("interfaces", []) %}
{% for ip in interface.ip_addresses %}
   network {{ ip.address.split("/")[0] }}/32 area {{ ospf.area }}
{% endfor %}
{% endif %}
{% endfor %}
   max-lsa {{ ospf.max_lsa }}
!
{% endif %}
